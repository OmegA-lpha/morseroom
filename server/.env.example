# MorseRoom server configuration. Copy to `.env` and adjust as needed.
# (No secrets are required to run MorseRoom.)

# Port the Socket.IO/HTTP server listens on.
PORT=4000

# Comma-separated list of allowed browser origins (CORS).
# Pin this to your own domain(s) in production. Use "*" to allow any origin
# (convenient for quick self-hosting, not recommended for a public deployment).
CLIENT_ORIGIN=http://localhost:5173

# Set to "production" to also serve the built client from client/dist
# out of this same process (single-origin deployment).
# NODE_ENV=production
