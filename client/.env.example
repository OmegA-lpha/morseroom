# MorseRoom client configuration. Copy to `.env` and adjust as needed.
# These are baked in at build time (Vite), so rebuild after changing them.
# (No secrets are required to run MorseRoom.)

# URL of the Socket.IO server. Leave unset to use http://localhost:4000 in
# local dev and the same origin as the web app in production.
# VITE_SERVER_URL=https://morse.example.com

# Target of the "Open Source on GitHub" link on the home screen.
# Set this to your own repository when you fork the project.
# VITE_GITHUB_URL=https://github.com/your-name/morseroom
